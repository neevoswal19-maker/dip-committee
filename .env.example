# Copy to .env and fill in. Never commit .env - the repo is public on
# Streamlit Community Cloud's free tier.

ANTHROPIC_API_KEY=sk-ant-...

# Telegram alerts. Create a bot with @BotFather, then get your chat id
# by messaging the bot and opening api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Password gate on the dashboard, so the public URL is not an open window
# into your positions.
DASHBOARD_PASSWORD=

# Deployment only. Leave unset locally to use SQLite.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
